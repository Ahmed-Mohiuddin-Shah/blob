# Control-plane base URL (HTTPS in prod). Worker opens WSS to this host;
# no inbound ports or tunnels on the worker machine.
BLOB_URL=https://blob.example.com

# Bearer token from superadmin “Create worker key” in /profile/workers.
# Rotate by revoking the old key and minting a new one.
WORKER_API_KEY=

# GLASS object API — same contract as the app. Worker downloads sources and
# uploads encode outputs here (not through the Next.js process).
GLASS_API_URL=https://glass.example.com
GLASS_API_KEY=

# Max jobs this process runs in parallel. Keep at 1 on small VMs
# (canvas / FFmpeg are memory-heavy); raise only when the host has headroom.
WORKER_CONCURRENCY=1

# Comma-separated job types this worker will claim. Omit a type to leave it
# for other workers (or the app’s single-flight local fallback).
# Values: composition_encode, sheet_encode, pack_encode, search_enrich
WORKER_CAPABILITIES=composition_encode,sheet_encode,pack_encode,search_enrich

# Ollama — search_enrich: vision describe → agent JSON (same host as app)
OLLAMA_BASE_URL=https://ollama.example.com
OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=moondream
OLLAMA_AGENT_MODEL=qwen2.5:3b

# Optional: stable instance id shown in /profile/workers (default: random UUID).
# WORKER_INSTANCE_ID=

# Optional: version string reported in heartbeats.
# WORKER_VERSION=0.1.0
