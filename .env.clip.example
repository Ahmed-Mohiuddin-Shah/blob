# Published host port → container 8080
CLIP_PUBLISH_PORT=8081

# open_clip architecture + pretrained tag
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
# Name Meili / Blob use in MEILI_MULTIMODAL_MODEL
CLIP_MODEL_ID=openclip-vit-b-32

# Leave empty for auto (cuda if available). Set cpu for no-GPU hosts.
# CLIP_DEVICE=cpu

# Optional Bearer token — set the same value as MEILI_MULTIMODAL_API_KEY on the blob app
# CLIP_API_KEY=

# Unload weights after idle seconds (0 = keep loaded). Helps share a 6GB GPU with Ollama.
CLIP_IDLE_UNLOAD_SECONDS=300

NVIDIA_VISIBLE_DEVICES=all
