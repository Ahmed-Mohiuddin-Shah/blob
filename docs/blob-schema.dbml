# BLOB Sticker Library — locked v1 schema (dbdiagram.io)
# Import at https://dbdiagram.io
# Target: Next.js + Auth.js (Zitadel OIDC) + PostgreSQL (+ Prisma)
# Revision: Composition editor unlock — assets + compositions; fit_mode removed
#
# Enums are documented as notes; store as text/varchar + app validation
# (or PostgreSQL ENUM / CHECK in migrations).
#
role: user | member | admin | superadmin
account_status: active | pending | suspended | banned
visibility: public | unlisted | private
moderation_status: draft | pending_review | needs_edit | approved | rejected | hidden | deleted
moderation_action: submitted | approved | rejected | edit_requested | resubmitted | edited | hidden | deleted | claim_submitted | claim_approved | claim_rejected
moderation_subject_type: sticker | collection | attribution_claim | blobber_edit_request | blobber_association_request
processing_status: processing | ready | failed
media_kind: image | chat | thumbnail | mask | gif | video
media_asset_status: pending | ready | failed
attribution_claim_reason: missing | mislabeled
attribution_claim_status: pending | approved | rejected
blobber_request_status: pending | approved | rejected | needs_edit
social_link_type: youtube | instagram | internet | merch | other
print_format: pdf | png
print_status: pending | ready | failed
collection_item_type: sticker | sticker_sheet | sticker_pack
favorite_subject_type: sticker | collection | sticker_sheet | sticker_pack

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

Table users {
  id bigserial [pk]
  zitadel_id varchar(64) [unique, not null, note: 'OIDC sub from Zitadel']
  username varchar(50) [unique, not null, note: 'URL-safe handle']
  display_name varchar(100) [not null]
  email varchar(255) [unique, not null]
  email_verified_at timestamptz [null, note: 'From Zitadel email_verified claim']
  role varchar(20) [not null, default: 'user', note: 'Mirror of Zitadel project role: user | member | admin | superadmin']
  account_status varchar(20) [not null, default: 'active', note: 'Local only: active | pending | suspended | banned']
  glass_private_prism_id uuid [null, note: 'Per-user private GLASS PRISM for pending uploads']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Zitadel is the sole IdP (Auth.js OIDC + PKCE). Roles SoT = Zitadel project roles; users.role is a mirror. First local signup (and one-shot lowest-id admin if none) becomes superadmin; further superadmin grants are Zitadel-only (not via BLOB UI/API). Profile name/email SoT = Zitadel (editable via Management API from BLOB). username local (blobatar). account_status local. No password, no avatar_url. Session is Auth.js JWT — no app sessions table.'
}

// ---------------------------------------------------------------------------
// GLASS: app public PRISM (singleton) + temporary upload tracker
// ---------------------------------------------------------------------------

Table public_prism {
  id bigserial [pk]
  key varchar(32) [unique, not null, default: 'default', note: 'Singleton sentinel — only one row (key=default)']
  glass_prism_id uuid [unique, not null, note: 'GLASS PRISM UUID created by BLOB via glass-ts; is_public=true']
  label varchar(100) [not null, note: 'e.g. blob-public']
  created_at timestamptz [not null]

  Note: 'LOCKED: App-owned public PRISM. Not configured via env. On first need, BLOB calls Glass prisms.create(is_public=true), inserts here, caches glass_prism_id in-process. Restarts load from this table. Disjoint from users/stickers/media_assets.'
}

Table glass_uploads {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id]
  object_id uuid [not null, note: 'GLASS object UUID']
  prism_id uuid [not null, note: 'Current PRISM (private until approved)']
  title varchar(200) [not null]
  size integer [not null, default: 0]
  checksum varchar(128) [null]
  status varchar(20) [not null, default: 'pending', note: 'pending | approved | rejected']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Temporary Glass upload tracker for profile upload/view before full stickers/media_assets. On admin approve: link object to public_prism.glass_prism_id, unlink from user private prism.'
}

# ---------------------------------------------------------------------------
# Catalog: categories & tags
# ---------------------------------------------------------------------------

Table categories {
  id bigserial [pk]
  parent_id bigint [null, ref: > categories.id, note: 'Null = top-level']
  slug varchar(80) [unique, not null]
  name varchar(100) [not null]
  description text [null]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Controlled hierarchy (Memes, Reactions, Animals, …). Not free-form.'
}

Table tags {
  id bigserial [pk]
  slug varchar(80) [unique, not null, note: 'Lowercase slug for uniqueness / search keys']
  name varchar(80) [not null, note: 'Display name stored ALL CAPS on save (e.g. ANGRY CAT)']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Free-form descriptive metadata. name = ALL CAPS; slug = lowercase. Meilisearch (planned) indexes case-insensitively.'
}

# ---------------------------------------------------------------------------
# Blobbers (public credit identity + CMS)
# ---------------------------------------------------------------------------

Table blobbers {
  id bigserial [pk]
  user_id bigint [null, unique, ref: > users.id, note: 'Linked account; null = unlinked external Blobber']
  display_name varchar(200) [not null, note: 'Unique case-insensitive (lower(display_name) unique index)']
  description text [null]
  banner_glass_object_id uuid [null]
  avatar_glass_object_id uuid [null]
  show_stickers boolean [not null, default: true]
  show_collections boolean [not null, default: true]
  show_sticker_sheets boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Public profile at /blobbers/{id}. Live row = approved CMS state. Edits go through blobber_edit_requests.'
}

Table social_links {
  id bigserial [pk]
  link_type varchar(20) [not null, note: 'youtube | instagram | internet | other']
  handle varchar(200) [not null]
  url varchar(2048) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table blobber_social_links {
  blobber_id bigint [not null, ref: > blobbers.id]
  social_link_id bigint [not null, ref: > social_links.id]

  indexes {
    (blobber_id, social_link_id) [pk]
  }
}

Table blobber_edit_requests {
  id bigserial [pk]
  blobber_id bigint [not null, ref: > blobbers.id]
  requester_id bigint [not null, ref: > users.id]
  proposed_payload jsonb [not null, note: 'display_name, description, banner/avatar, section bools, social_links[]']
  status varchar(20) [not null, default: 'pending', note: 'pending | approved | rejected | needs_edit']
  admin_note text [null]
  reviewed_by bigint [null, ref: > users.id]
  reviewed_at timestamptz [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (status, created_at) [name: 'idx_blobber_edit_requests_queue']
    blobber_id [name: 'idx_blobber_edit_requests_blobber']
  }

  Note: 'Public profile unchanged until approve. Admin UI shows live vs proposed side-by-side.'
}

Table blobber_association_requests {
  id bigserial [pk]
  requester_id bigint [not null, ref: > users.id]
  target_blobber_id bigint [not null, ref: > blobbers.id]
  message text [null]
  status varchar(20) [not null, default: 'pending', note: 'pending | approved | rejected']
  admin_note text [null]
  reviewed_by bigint [null, ref: > users.id]
  reviewed_at timestamptz [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (status, created_at) [name: 'idx_blobber_association_requests_queue']
    (requester_id, target_blobber_id, status) [name: 'idx_blobber_association_requests_requester']
  }

  Note: 'On approve: clear old linked blobber.user_id (row kept), set target.user_id, re-point stickers from old → target.'
}

# ---------------------------------------------------------------------------
# Shared moderation audit (stickers now; collections / packs / layouts later)
# ---------------------------------------------------------------------------

Table moderation_events {
  id bigserial [pk]
  subject_type varchar(40) [not null, note: 'sticker | collection | sticker_pack | print_layout | attribution_claim | blobber_edit_request | blobber_association_request']
  subject_id bigint [not null, note: 'No FK — survives hard delete of subject']
  subject_title varchar(220) [not null, note: 'Snapshot title for history after purge']
  action varchar(40) [not null, note: 'submitted | approved | rejected | edit_requested | resubmitted | edited | hidden | deleted | claim_submitted | claim_approved | claim_rejected']
  actor_id bigint [not null, ref: > users.id]
  note text [null, note: 'Required for edit_requested and claim approve/reject']
  created_at timestamptz [not null]

  indexes {
    (subject_type, subject_id, created_at) [name: 'idx_moderation_events_subject']
    created_at [name: 'idx_moderation_events_created']
    actor_id [name: 'idx_moderation_events_actor']
  }

  Note: 'Polymorphic moderation history. Reuse for collections, sticker packs, print layouts when those domains gain moderation. Reject on stickers = purge GLASS then delete row; event retained.'
}

Table processing_logs {
  id bigserial [pk]
  subject_type varchar(40) [not null, note: 'sticker | sticker_sheet | sticker_pack']
  subject_id bigint [not null]
  subject_title varchar(220) [not null]
  message text [not null]
  created_at timestamptz [not null]

  indexes {
    created_at [name: 'idx_processing_logs_created']
    (subject_type, subject_id, created_at) [name: 'idx_processing_logs_subject']
  }

  Note: 'Append-only encode/process failure log. Survives clearing of processing_error / error_message on retry. Superadmin profile UI.'
}

Table tag_aliases {
  id bigserial [pk]
  tag_id bigint [not null, ref: > tags.id]
  alias varchar(80) [unique, not null, note: 'Normalized alias string, e.g. kitty → cat']
  created_at timestamptz [not null]

  Note: 'Schema ready in v1; alias expansion in search is Should-have.'
}

# ---------------------------------------------------------------------------
# Immutable originals (shared across remixes)
# ---------------------------------------------------------------------------

Table assets {
  id bigserial [pk]
  uploaded_by bigint [not null, ref: > users.id]
  sha256 char(64) [null, note: 'Lowercase hex SHA-256']
  mime_type varchar(100) [not null]
  file_extension varchar(20) [not null]
  width integer [null]
  height integer [null]
  duration_ms integer [null, note: 'Video/GIF duration; null for static image']
  frame_count integer [null]
  frame_rate decimal(8,3) [null]
  has_audio boolean [not null, default: false]
  size_bytes bigint [not null, default: 0]
  glass_object_id uuid [not null]
  glass_prism_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    sha256 [name: 'idx_assets_sha256']
    glass_object_id [name: 'idx_assets_glass_object']
  }

  Note: 'Immutable original media. Composition documents reference asset id. Remixes reuse the same asset rows (no byte copy). Never mutate after create.'
}

# ---------------------------------------------------------------------------
# Stickers + compositions
# ---------------------------------------------------------------------------

Table stickers {
  id bigserial [pk]
  title varchar(200) [not null]
  description text [null]
  slug varchar(220) [unique, not null]

  created_by bigint [not null, ref: > users.id, note: 'Original creator / artist / remixer']
  uploaded_by bigint [not null, ref: > users.id, note: 'Account that uploaded primary original(s) or initiated remix']
  remixed_from_sticker_id bigint [null, ref: > stickers.id, note: 'Nullable self-FK: set when this sticker was remixed from another. Complements composition_parents.']

  category_id bigint [null, ref: > categories.id, note: 'Single primary category']

  blobber_id bigint [null, ref: > blobbers.id, note: 'Credit Blobber; null = unknown / no credit']
  source_url varchar(2048) [null, note: 'External source link; null = muted credit (link to /blobbers/{id} only)']
  license varchar(100) [null]
  copyright_status varchar(50) [null]

  alternate_names text [null, note: 'Newline or comma-separated aliases for search']
  keywords text [null, note: 'Extra search keywords']

  visibility varchar(20) [not null, default: 'public', note: 'public | unlisted | private']
  moderation_status varchar(30) [not null, default: 'pending_review', note: 'draft | pending_review | needs_edit | approved | rejected | hidden | deleted']
  moderation_note text [null, note: 'Current open edit-request reason; cleared on resubmit']
  processing_status varchar(20) [not null, default: 'processing', note: 'processing | ready | failed']
  processing_error text [null]

  views_count bigint [not null, default: 0]
  downloads_count bigint [not null, default: 0]
  likes_count bigint [not null, default: 0, note: 'Denormalized favourite count for this sticker (favorites where subject_type=sticker). Updated when users favourite/unfavourite.']
  shares_count bigint [not null, default: 0]
  search_appearances_count bigint [not null, default: 0]

  search_vector text [null, note: 'v1: tsvector in PG. Planned: Meilisearch indexes same fields (title, aliases, tags, categories, keywords) post-v1']

  published_at timestamptz [null, note: 'Set when first approved + public']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    remixed_from_sticker_id [name: 'idx_stickers_remixed_from']
    blobber_id [name: 'idx_stickers_blobber']
  }

  Note: 'Primary library object. Framing/edits live in compositions.document_json (1024²). fit_mode/pad_background removed. Published face = media_assets from current composition revision. Remix dual provenance: remixed_from_sticker_id (UI) + composition_parents (composition lineage). Reject = hard purge sticker (+ composition cascade); shared assets retained if still referenced. On approve, discard media_assets whose composition_revision_id ≠ current revision. Credit via blobber_id + source_url.'
}

Table compositions {
  id bigserial [pk]
  sticker_id bigint [unique, not null, ref: > stickers.id, note: '1:1 with sticker']
  owner_id bigint [not null, ref: > users.id]
  current_revision_id bigint [null, note: 'FK to composition_revisions.id; set after first save']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Editable recipe behind a sticker. current_revision_id points at latest saved document. Soft circular FK to revisions — enforce in app/migration.'
}

Table composition_revisions {
  id bigserial [pk]
  composition_id bigint [not null, ref: > compositions.id]
  revision integer [not null, note: 'Monotonic per composition; starts at 1']
  document_json jsonb [not null, note: 'BLOB Composition JSON (version, canvas 1024², objects). Never Konva/Fabric JSON.']
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null]

  indexes {
    (composition_id, revision) [unique, name: 'uq_composition_revisions']
  }

  Note: 'Immutable saved documents. Save = insert new revision. Local undo stays in the client.'
}

Table composition_parents {
  composition_id bigint [not null, ref: > compositions.id]
  parent_composition_id bigint [not null, ref: > compositions.id]
  sort_order integer [not null, default: 0]

  indexes {
    (composition_id, parent_composition_id) [pk]
  }

  Note: 'Composition remix lineage (deep-copy provenance). Complement to stickers.remixed_from_sticker_id for UI. Not live layer binding; parent edits do not affect children.'
}

Table attribution_claims {
  id bigserial [pk]
  sticker_id bigint [not null, ref: > stickers.id]
  claimant_id bigint [not null, ref: > users.id, note: 'Signed-in user only']
  reason varchar(20) [not null, note: 'missing | mislabeled']
  contact_name varchar(200) [not null]
  contact_email varchar(255) [not null]
  message text [null]
  proposed_blobber_id bigint [null, ref: > blobbers.id, note: 'Existing Blobber pick']
  proposed_blobber_display_name varchar(200) [null, note: 'Create/find-or-merge unlinked on approve when id null']
  proposed_source_url varchar(2048) [null]
  status varchar(20) [not null, default: 'pending', note: 'pending | approved | rejected']
  admin_note text [null, note: 'Required on approve/reject']
  reviewed_by bigint [null, ref: > users.id]
  reviewed_at timestamptz [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (status, created_at) [name: 'idx_attribution_claims_queue']
    sticker_id [name: 'idx_attribution_claims_sticker']
    (claimant_id, sticker_id, status) [name: 'idx_attribution_claims_claimant']
  }

  Note: 'Signed-in claim that source is missing or mislabeled. Approve resolves Blobber (id or find-or-merge by display name) and applies blobber_id + source_url on the sticker. Events also land in moderation_events (subject_type=attribution_claim).'
}

Table sticker_tags {
  sticker_id bigint [not null, ref: > stickers.id]
  tag_id bigint [not null, ref: > tags.id]

  indexes {
    (sticker_id, tag_id) [pk]
  }
}

Table media_assets {
  id bigserial [pk]
  sticker_id bigint [not null, ref: > stickers.id]
  composition_revision_id bigint [null, ref: > composition_revisions.id, note: 'Revision that produced this derivative; null for legacy/orphan']

  kind varchar(20) [not null, note: 'image | chat | thumbnail | mask | gif | video — sizes: image=1024, chat=128, thumbnail=256']
  mime_type varchar(100) [not null]
  file_extension varchar(20) [not null]
  width integer [null]
  height integer [null]
  duration_ms integer [null, note: 'Video/GIF duration; null for static image']
  frame_count integer [null, note: 'GIF frames if known']
  has_audio boolean [not null, default: false, note: 'Video: preserve audio when present']
  size_bytes bigint [not null, default: 0]
  checksum_sha256 char(64) [null, note: 'Lowercase hex SHA-256 from GLASS upload']

  glass_object_id uuid [not null, note: 'GLASS object UUID']
  glass_prism_id uuid [not null, note: 'PRISM the object is linked into']

  status varchar(20) [not null, default: 'pending', note: 'pending | ready | failed']
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (sticker_id, kind) [unique, note: 'One current asset per kind per sticker']
  }

  Note: 'Derivatives / cache only. Originals live in assets. Regenerated from current composition revision. Public outputs strip EXIF. mask = smart-cutout alpha.'
}

Table favorites {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id]
  subject_type varchar(40) [not null, note: 'sticker | collection | sticker_sheet | sticker_pack']
  subject_id bigint [not null]
  created_at timestamptz [not null]

  indexes {
    (user_id, subject_type, subject_id) [unique]
    (user_id, created_at)
  }

  Note: 'Private polymorphic bookmark. No subject FK. For stickers, toggling favourite also maintains stickers.likes_count (public like tally).'
}

# ---------------------------------------------------------------------------
# Collections (always public; unique name+slug globally)
# ---------------------------------------------------------------------------

Table collections {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id]
  name varchar(120) [unique, not null]
  slug varchar(140) [unique, not null]
  description text [null]
  likes_count bigint [not null, default: 0, note: 'Denormalized favourite count (favorites where subject_type=collection).']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Always public. Globally unique name and slug. Not deletable by users. Holds stickers, sheets, packs (1–60 items).'
}

Table collection_items {
  collection_id bigint [not null, ref: > collections.id]
  subject_type varchar(40) [not null, note: 'sticker | sticker_sheet | sticker_pack']
  subject_id bigint [not null]
  sort_order integer [not null, default: 0]
  added_at timestamptz [not null]

  indexes {
    (collection_id, subject_type, subject_id) [pk]
    (subject_type, subject_id)
  }

  Note: 'Polymorphic membership. Max 60 items enforced in app. Cannot remove the last item.'
}

Table collection_tags {
  collection_id bigint [not null, ref: > collections.id]
  tag_id bigint [not null, ref: > tags.id]

  indexes {
    (collection_id, tag_id) [pk]
  }
}

# ---------------------------------------------------------------------------
# Prints domain (sheets-first)
# ---------------------------------------------------------------------------

Table sticker_sheets {
  id bigserial [pk]
  name varchar(200) [not null]
  slug varchar(220) [unique, not null]
  description text [null]
  created_by bigint [not null, ref: > users.id]
  print_document_json json [not null, note: 'PrintDocument v1 (mm page + asset_id refs)']
  status varchar(20) [not null, default: 'pending', note: 'pending | ready | failed']
  error_message text [null]
  png_glass_object_id uuid [null]
  png_glass_prism_id uuid [null]
  pdf_glass_object_id uuid [null]
  pdf_glass_prism_id uuid [null]
  png_size_bytes bigint [null]
  pdf_size_bytes bigint [null]
  likes_count bigint [not null, default: 0, note: 'Denormalized favourite count (favorites where subject_type=sticker_sheet).']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Sticker Sheet = single printable page. Always public. Not deletable. Page presets (A4/A5) live in blob-editor/print, not DB.'
}

Table sheet_stickers {
  sheet_id bigint [not null, ref: > sticker_sheets.id]
  sticker_id bigint [not null, ref: > stickers.id]
  sort_order integer [not null, default: 0]

  indexes {
    (sheet_id, sticker_id) [pk]
  }

  Note: 'Source stickers on a sheet (max 20). asset_id in PrintDocument = sticker id string.'
}

Table sticker_packs {
  id bigserial [pk]
  name varchar(200) [not null]
  slug varchar(220) [unique, not null]
  description text [null]
  created_by bigint [not null, ref: > users.id]
  status varchar(20) [not null, default: 'pending', note: 'pending | ready | failed']
  error_message text [null]
  png_glass_object_id uuid [null]
  png_glass_prism_id uuid [null]
  pdf_glass_object_id uuid [null]
  pdf_glass_prism_id uuid [null]
  png_size_bytes bigint [null]
  pdf_size_bytes bigint [null]
  likes_count bigint [not null, default: 0, note: 'Denormalized favourite count (favorites where subject_type=sticker_pack).']
  sheets_hash varchar(64) [unique, not null, note: 'sha256 hex of sorted sheet ids ("1,2,3"); order-insensitive pack membership fingerprint']
  source_collection_id bigint [unique, null, ref: - collections.id, note: '1:1: pack combined from this collection; create once, update membership on recombine']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Sticker Pack = bundle of ≥2 sheets (combined PDF + contact-sheet PNG). Always public. Not deletable. Stores sheet FKs. Duplicate sheet sets rejected via sheets_hash. Optional source_collection_id links the collection-combined pack (membership excludes that pack when expanding).'
}

Table pack_sheets {
  pack_id bigint [not null, ref: > sticker_packs.id]
  sheet_id bigint [not null, ref: > sticker_sheets.id]
  sort_order integer [not null, default: 0]

  indexes {
    (pack_id, sheet_id) [pk]
  }

  Note: 'Ordered sheet references inside a pack. Min 2 sheets enforced in app.'
}

Table worker_api_keys {
  id bigserial [pk]
  name varchar(120) [not null]
  key_hash char(64) [unique, not null, note: 'sha256 hex of secret; plaintext shown once on create']
  prefix varchar(16) [not null, note: 'Display prefix e.g. first 8 of blob_wk_…']
  revoked_at timestamptz [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Superadmin-minted bearer keys for remote encode workers.'
}

Table workers {
  id bigserial [pk]
  api_key_id bigint [not null, ref: > worker_api_keys.id]
  instance_id varchar(64) [not null]
  version varchar(40) [not null, default: '0']
  capabilities text [not null, default: '[]', note: 'JSON string array of job types']
  concurrency integer [not null, default: 1]
  cpu_pct float [null]
  mem_mb float [null]
  status varchar(20) [not null, default: 'offline', note: 'online | offline']
  last_heartbeat_at timestamptz [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (api_key_id, instance_id) [unique]
    (status, last_heartbeat_at)
  }

  Note: 'Fleet row updated by WSS register/heartbeat. Control plane sole DB owner.'
}

Table jobs {
  id bigserial [pk]
  type varchar(40) [not null, note: 'composition_encode | sheet_encode | pack_encode']
  subject_type varchar(40) [not null, note: 'sticker | sticker_sheet | sticker_pack']
  subject_id bigint [not null]
  status varchar(20) [not null, default: 'pending', note: 'pending | leased | running | succeeded | failed']
  idempotency_key varchar(120) [unique, not null]
  payload jsonb [null]
  result jsonb [null]
  worker_id bigint [null, ref: > workers.id]
  lease_expires_at timestamptz [null]
  attempts integer [not null, default: 0]
  last_error text [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (status, lease_expires_at)
    (type, status)
    (subject_type, subject_id)
  }

  Note: 'Durable encode work. WSS notifies workers; expired leases reclaim to pending. Local fallback when no capable online worker.'
}
