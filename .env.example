# App
AUTH_URL=http://localhost:3000
NODE_ENV=development

# Session (Auth.js)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_DURATION=3600

# Postgres (compose + local)
DB_DATABASE=blob
DB_USERNAME=blob
DB_PASSWORD=change-me
DB_PUBLISH_PORT=5433
APP_PORT=8080
DATABASE_URL=postgresql://blob:change-me@localhost:5433/blob?schema=public

# Zitadel (sole IdP) — Authorization Code + PKCE
# Console Redirect URI must match ZITADEL_CALLBACK_URL exactly.
# Console Post Logout Redirect URI must match ZITADEL_POST_LOGOUT_URL exactly.
ZITADEL_DOMAIN=https://auth.example.com
ZITADEL_CLIENT_ID=
# Auth.js requires a value even for public PKCE clients — use a random string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZITADEL_CLIENT_SECRET=
ZITADEL_CALLBACK_URL=http://localhost:3000/api/auth/callback/zitadel
ZITADEL_POST_LOGIN_URL=/profile
ZITADEL_POST_LOGOUT_URL=http://localhost:3000/api/auth/logout/callback
# Management API (service account PAT — role grants + profile updates)
ZITADEL_SERVICE_PAT=
ZITADEL_ORG_ID=
ZITADEL_PROJECT_ID=

# GLASS API (glass-ts)
# Public PRISM is created by the app and stored in `public_prism` — not configured here.
GLASS_API_KEY=
GLASS_API_URL=

# Distributed workers (control plane)
# Dead-man lease: if a worker stops sending job.progress for this many seconds,
# the job returns to pending for another worker / local fallback. Healthy workers
# renew progress every ~30s, so raise this only if encodes can stall that long
# without progress (stuck, not merely slow).
WORKER_LEASE_SECONDS=120

# Meilisearch (omit MEILI_HOST to keep Prisma contains fallback)
# Host-run app (npm run dev): http://localhost:7700
# Docker Compose app service forces http://meilisearch:7700 (ignore this value in the container)
MEILI_HOST=http://localhost:7700
MEILI_PUBLISH_PORT=7700
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEILI_MASTER_KEY=
# Search-only key from Meili dashboard /keys (optional; falls back to master for server-side)
MEILI_SEARCH_KEY=
# Browser InstantSearch (optional; omit to use /api/search BFF only)
# NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
# NEXT_PUBLIC_MEILI_SEARCH_KEY=

# Ollama (text embed + vision captions + agentic search)
OLLAMA_BASE_URL=https://ollama.example.com
OLLAMA_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=moondream
OLLAMA_AGENT_MODEL=qwen2.5:3b

# Self-hosted CLIP (Meili multimodal) — run on Ollama/GPU host:
#   cp .env.clip.example .env.clip && docker compose -f docker-compose.clip.yml up -d --build
# Point this at the public URL of that host (Meili container must reach it).
MEILI_MULTIMODAL_URL=https://clip.example.com
MEILI_MULTIMODAL_MODEL=openclip-vit-b-32
# Same as CLIP_API_KEY in .env.clip if you set one
MEILI_MULTIMODAL_API_KEY=
