# App
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET= # openssl rand -hex 32

# Postgres (compose + local)
DB_DATABASE=blob
DB_USERNAME=blob
DB_PASSWORD=change-me
DB_PUBLISH_PORT=5433
APP_PORT=8080
DATABASE_URL=postgresql://blob:change-me@localhost:5433/blob?schema=public

# Zitadel (sole IdP) — Auth.js callback must be:
#   {AUTH_URL}/api/auth/callback/zitadel
ZITADEL_ISSUER=https://auth.example.com
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/auth/logout/callback
