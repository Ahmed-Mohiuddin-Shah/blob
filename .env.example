# App
AUTH_URL=http://localhost:3000
NODE_ENV=development

# Session (Auth.js)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_DURATION=3600

# Postgres (compose + local)
DB_DATABASE=blob
DB_USERNAME=blob
DB_PASSWORD=change-me
DB_PUBLISH_PORT=5433
APP_PORT=8080
DATABASE_URL=postgresql://blob:change-me@localhost:5433/blob?schema=public

# Zitadel (sole IdP) — Authorization Code + PKCE
# Console Redirect URI must match ZITADEL_CALLBACK_URL exactly.
# Console Post Logout Redirect URI must match ZITADEL_POST_LOGOUT_URL exactly.
ZITADEL_DOMAIN=https://auth.example.com
ZITADEL_CLIENT_ID=
# Auth.js requires a value even for public PKCE clients — use a random string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZITADEL_CLIENT_SECRET=
ZITADEL_CALLBACK_URL=http://localhost:3000/api/auth/callback/zitadel
ZITADEL_POST_LOGIN_URL=/profile
ZITADEL_POST_LOGOUT_URL=http://localhost:3000/api/auth/logout/callback

# GLASS API
GLASS_API_KEY=
GLASS_API_URL=