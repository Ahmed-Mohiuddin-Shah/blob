generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Local app user. Zitadel is sole IdP. Roles mirrored from Zitadel. Avatars via blobatar(username).
model User {
  id                  BigInt    @id @default(autoincrement())
  zitadelId           String    @unique @map("zitadel_id") @db.VarChar(64)
  username            String    @unique @db.VarChar(50)
  displayName         String    @map("display_name") @db.VarChar(100)
  email               String    @unique @db.VarChar(255)
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(6)
  role                String    @default("user") @db.VarChar(20) // Mirror of Zitadel: user | member | admin | superadmin
  accountStatus       String    @default("active") @map("account_status") @db.VarChar(20)
  glassPrivatePrismId String?   @map("glass_private_prism_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  glassUploads              GlassUpload[]
  stickersCreated           Sticker[]           @relation("StickerCreatedBy")
  stickersUploaded          Sticker[]           @relation("StickerUploadedBy")
  assetsUploaded            Asset[]
  compositionsOwned         Composition[]
  compositionRevisions      CompositionRevision[]
  moderationEvents          ModerationEvent[]
  attributionClaims         AttributionClaim[]  @relation("AttributionClaimant")
  attributionClaimsReviewed AttributionClaim[]  @relation("AttributionClaimReviewer")

  @@map("users")
}

/// Polymorphic moderation audit log. No subject FK so events survive hard deletes.
model ModerationEvent {
  id           BigInt   @id @default(autoincrement())
  subjectType  String   @map("subject_type") @db.VarChar(40)
  subjectId    BigInt   @map("subject_id")
  subjectTitle String   @map("subject_title") @db.VarChar(220)
  action       String   @db.VarChar(40)
  actorId      BigInt   @map("actor_id")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorId], references: [id])

  @@index([subjectType, subjectId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@map("moderation_events")
}

/// Temporary Glass object tracker (legacy profile upload/view). Prefer stickers.
model GlassUpload {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  objectId  String   @map("object_id") @db.Uuid
  prismId   String   @map("prism_id") @db.Uuid
  title     String   @db.VarChar(200)
  size      Int      @default(0)
  checksum  String?  @db.VarChar(128)
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("glass_uploads")
}

/// Singleton app public GLASS PRISM. Created once by BLOB via glass-ts; not an env UUID.
model PublicPrism {
  id           BigInt   @id @default(autoincrement())
  key          String   @unique @default("default") @db.VarChar(32)
  glassPrismId String   @unique @map("glass_prism_id") @db.Uuid
  label        String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("public_prism")
}

model Category {
  id          BigInt    @id @default(autoincrement())
  parentId    BigInt?   @map("parent_id")
  slug        String    @unique @db.VarChar(80)
  name        String    @db.VarChar(100)
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  stickers Sticker[]

  @@map("categories")
}

model Tag {
  id        BigInt   @id @default(autoincrement())
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stickers StickerTag[]

  @@map("tags")
}

/// Immutable original media. Composition documents reference asset id. Remixes reuse rows.
model Asset {
  id             BigInt   @id @default(autoincrement())
  uploadedById   BigInt   @map("uploaded_by")
  sha256         String?  @db.Char(64)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  fileExtension  String   @map("file_extension") @db.VarChar(20)
  width          Int?
  height         Int?
  durationMs     Int?     @map("duration_ms")
  frameCount     Int?     @map("frame_count")
  frameRate      Decimal? @map("frame_rate") @db.Decimal(8, 3)
  hasAudio       Boolean  @default(false) @map("has_audio")
  sizeBytes      BigInt   @default(0) @map("size_bytes")
  glassObjectId  String   @map("glass_object_id") @db.Uuid
  glassPrismId   String   @map("glass_prism_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([sha256])
  @@index([glassObjectId])
  @@map("assets")
}

model Sticker {
  id                     BigInt    @id @default(autoincrement())
  title                  String    @db.VarChar(200)
  description            String?
  slug                   String    @unique @db.VarChar(220)
  createdById            BigInt    @map("created_by")
  uploadedById           BigInt    @map("uploaded_by")
  remixedFromStickerId   BigInt?   @map("remixed_from_sticker_id")
  categoryId             BigInt?   @map("category_id")
  /// Credit label when attribution is present (upload/claim). Null = no attribution.
  authorName             String?   @map("author_name") @db.VarChar(200)
  attribution            String?
  /// Source link when attribution is present. Null = no attribution.
  sourceUrl              String?   @map("source_url") @db.VarChar(2048)
  license                String?   @db.VarChar(100)
  copyrightStatus        String?   @map("copyright_status") @db.VarChar(50)
  alternateNames         String?   @map("alternate_names")
  keywords               String?
  visibility             String    @default("public") @db.VarChar(20)
  moderationStatus       String    @default("pending_review") @map("moderation_status") @db.VarChar(30)
  moderationNote         String?   @map("moderation_note")
  processingStatus       String    @default("processing") @map("processing_status") @db.VarChar(20)
  processingError        String?   @map("processing_error")
  viewsCount             BigInt    @default(0) @map("views_count")
  downloadsCount         BigInt    @default(0) @map("downloads_count")
  likesCount             BigInt    @default(0) @map("likes_count")
  sharesCount            BigInt    @default(0) @map("shares_count")
  searchAppearancesCount BigInt    @default(0) @map("search_appearances_count")
  publishedAt            DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy          User               @relation("StickerCreatedBy", fields: [createdById], references: [id])
  uploadedBy         User               @relation("StickerUploadedBy", fields: [uploadedById], references: [id])
  remixedFrom        Sticker?           @relation("StickerRemixes", fields: [remixedFromStickerId], references: [id], onDelete: SetNull)
  remixes            Sticker[]          @relation("StickerRemixes")
  category           Category?          @relation(fields: [categoryId], references: [id])
  tags               StickerTag[]
  media              MediaAsset[]
  composition        Composition?
  attributionClaims  AttributionClaim[]

  @@index([moderationStatus, processingStatus, visibility])
  @@index([uploadedById])
  @@index([categoryId])
  @@index([remixedFromStickerId])
  @@map("stickers")
}

model Composition {
  id                BigInt   @id @default(autoincrement())
  stickerId         BigInt   @unique @map("sticker_id")
  ownerId           BigInt   @map("owner_id")
  currentRevisionId BigInt?  @map("current_revision_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sticker         Sticker               @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  owner           User                  @relation(fields: [ownerId], references: [id])
  revisions       CompositionRevision[]
  parentOf        CompositionParent[]   @relation("CompositionChild")
  childOf         CompositionParent[]   @relation("CompositionParent")

  @@map("compositions")
}

model CompositionRevision {
  id            BigInt   @id @default(autoincrement())
  compositionId BigInt   @map("composition_id")
  revision      Int
  documentJson  Json     @map("document_json")
  createdById   BigInt   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  composition Composition  @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])
  media       MediaAsset[]

  @@unique([compositionId, revision])
  @@map("composition_revisions")
}

model CompositionParent {
  compositionId       BigInt @map("composition_id")
  parentCompositionId BigInt @map("parent_composition_id")
  sortOrder           Int    @default(0) @map("sort_order")

  composition       Composition @relation("CompositionChild", fields: [compositionId], references: [id], onDelete: Cascade)
  parentComposition Composition @relation("CompositionParent", fields: [parentCompositionId], references: [id], onDelete: Cascade)

  @@id([compositionId, parentCompositionId])
  @@map("composition_parents")
}

/// Signed-in user claim that attribution is missing or mislabeled.
model AttributionClaim {
  id                 BigInt    @id @default(autoincrement())
  stickerId          BigInt    @map("sticker_id")
  claimantId         BigInt    @map("claimant_id")
  reason             String    @db.VarChar(20)
  contactName        String    @map("contact_name") @db.VarChar(200)
  contactEmail       String    @map("contact_email") @db.VarChar(255)
  message            String?
  proposedAuthorName String    @map("proposed_author_name") @db.VarChar(200)
  proposedSourceUrl  String    @map("proposed_source_url") @db.VarChar(2048)
  status             String    @default("pending") @db.VarChar(20)
  adminNote          String?   @map("admin_note")
  reviewedById       BigInt?   @map("reviewed_by")
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sticker    Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  claimant   User    @relation("AttributionClaimant", fields: [claimantId], references: [id])
  reviewedBy User?   @relation("AttributionClaimReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([stickerId])
  @@index([claimantId, stickerId, status])
  @@map("attribution_claims")
}

model StickerTag {
  stickerId BigInt @map("sticker_id")
  tagId     BigInt @map("tag_id")

  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([stickerId, tagId])
  @@map("sticker_tags")
}

/// Derivatives / cache only. Originals live in assets. Regenerated from current composition revision.
model MediaAsset {
  id                    BigInt   @id @default(autoincrement())
  stickerId             BigInt   @map("sticker_id")
  compositionRevisionId BigInt?  @map("composition_revision_id")
  kind                  String   @db.VarChar(20)
  mimeType              String   @map("mime_type") @db.VarChar(100)
  fileExtension         String   @map("file_extension") @db.VarChar(20)
  width                 Int?
  height                Int?
  durationMs            Int?     @map("duration_ms")
  frameCount            Int?     @map("frame_count")
  hasAudio              Boolean  @default(false) @map("has_audio")
  sizeBytes             BigInt   @default(0) @map("size_bytes")
  checksumSha256        String?  @map("checksum_sha256") @db.Char(64)
  glassObjectId         String   @map("glass_object_id") @db.Uuid
  glassPrismId          String   @map("glass_prism_id") @db.Uuid
  status                String   @default("pending") @db.VarChar(20)
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sticker             Sticker              @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  compositionRevision CompositionRevision? @relation(fields: [compositionRevisionId], references: [id], onDelete: SetNull)

  @@unique([stickerId, kind])
  @@index([compositionRevisionId])
  @@map("media_assets")
}
